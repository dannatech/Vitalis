# PostgreSQL connection. In production, keep this database in-country (Nigeria) or in a
# jurisdiction with adequate protection recognised by the NDPC — see COMPLIANCE.md §1.
DATABASE_URL="postgresql://vitalis:vitalis_dev_password@localhost:5432/vitalis?schema=public"

# JWT signing secret. DEV-ONLY VALUE BELOW — generate a real one for any shared
# environment with: openssl rand -base64 48
JWT_SECRET="dev-only-1f8b3c9e2a7d4f60b5c1e9a3d7f2b846-change-me"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="7d"

# AES-256-GCM key (32 raw bytes, base64-encoded) used to encrypt PII fields at rest
# (NIN, phone number). DEV-ONLY VALUE BELOW — generate a real one for any shared
# environment with: openssl rand -base64 32
# PRODUCTION NOTE: move this to a managed KMS/HSM (e.g. AWS KMS, Azure Key Vault, or an
# on-prem HSM) rather than a plain environment variable — see COMPLIANCE.md §6.
FIELD_ENCRYPTION_KEY="gjSM3TLVqpdKMeDpuSRmMO6fsTENAKR8nDSE/sMXuMY="

PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the frontend dev server by default)
CORS_ORIGINS="http://localhost:5173"
