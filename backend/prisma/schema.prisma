generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Facilities & staff
// ---------------------------------------------------------------------------

model Facility {
  id               String   @id @default(uuid())
  name             String
  /// NHIA-assigned facility code, where applicable
  nhisFacilityCode String?
  state            String
  lga              String // Local Government Area
  address          String?
  phone            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                    User[]
  patients                 Patient[]
  encounters               Encounter[]
  auditLogs                AuditLog[]
  notifiableDiseaseReports NotifiableDiseaseReport[]
  payers                   Payer[]
  tariffItems              TariffItem[]
  invoices                 Invoice[]
  claims                   Claim[]

  @@map("facilities")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  LAB_TECH
  RECORDS_OFFICER
  BILLING_OFFICER
}

model User {
  id             String    @id @default(uuid())
  facilityId     String
  facility       Facility  @relation(fields: [facilityId], references: [id])
  email          String    @unique
  passwordHash   String
  fullName       String
  role           Role
  /// Professional license number (MDCN/NMCN/PCN/etc.) for clinical roles
  licenseNumber  String?
  licenseBody    String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  encountersAsClinician Encounter[]        @relation("EncounterClinician")
  vitalsRecorded        VitalSigns[]
  diagnosesNoted        Diagnosis[]
  prescriptionsWritten  Prescription[]    @relation("PrescriptionPrescriber")
  prescriptionsDispensed Prescription[]   @relation("PrescriptionDispenser")
  labOrdersPlaced       LabOrder[]
  labResultsEntered     LabResult[]
  consentsRecorded      ConsentRecord[]
  patientsRegistered    Patient[]          @relation("PatientRegisteredBy")
  auditLogs             AuditLog[]
  dataSubjectRequests   DataSubjectRequest[] @relation("DSRHandledBy")
  chargeLinesCreated    ChargeLine[]
  invoicesCreated       Invoice[]
  paymentsReceived      Payment[]
  claimsCreated         Claim[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
}

model Patient {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])

  /// Facility-issued Medical Record Number, human-readable, unique per facility
  mrn String

  /// AES-256-GCM encrypted National Identification Number (NIMC NIN)
  ninEncrypted String?
  nhisNumber   String?

  surname     String
  firstName   String
  otherNames  String?
  dateOfBirth DateTime
  sex         Sex

  /// AES-256-GCM encrypted phone number
  phoneEncrypted String?
  address        String?
  state          String?
  lga            String?

  nextOfKinName    String?
  nextOfKinPhone   String?
  nextOfKinRelation String?

  bloodGroup String?
  genotype   String?

  registeredById String?
  registeredBy   User?   @relation("PatientRegisteredBy", fields: [registeredById], references: [id])

  /// Set when a right-to-erasure request has been fulfilled via anonymisation
  anonymisedAt DateTime?

  /// Idempotency key set by the offline client at creation time, so a sync
  /// retry never creates a duplicate patient.
  clientGeneratedId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  encounters          Encounter[]
  consentRecords       ConsentRecord[]
  dataSubjectRequests  DataSubjectRequest[]
  notifiableDiseaseReports NotifiableDiseaseReport[]
  coverages           PatientCoverage[]
  invoices            Invoice[]

  @@unique([facilityId, mrn])
  @@index([facilityId, surname, firstName])
  @@map("patients")
}

// ---------------------------------------------------------------------------
// NDPR: consent & data subject rights
// ---------------------------------------------------------------------------

enum ConsentPurpose {
  TREATMENT
  RESEARCH
  DATA_SHARING_NHIS
  DATA_SHARING_HMO
  MARKETING
}

enum ConsentMethod {
  VERBAL
  WRITTEN
  ELECTRONIC
}

model ConsentRecord {
  id         String         @id @default(uuid())
  patientId  String
  patient    Patient        @relation(fields: [patientId], references: [id])
  purpose    ConsentPurpose
  granted    Boolean
  method     ConsentMethod
  grantedAt  DateTime?
  revokedAt  DateTime?
  notes      String?

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([patientId, purpose])
  @@map("consent_records")
}

enum DataSubjectRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
}

enum DataSubjectRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model DataSubjectRequest {
  id        String                   @id @default(uuid())
  patientId String
  patient   Patient                  @relation(fields: [patientId], references: [id])
  type      DataSubjectRequestType
  status    DataSubjectRequestStatus @default(PENDING)
  requestedAt DateTime               @default(now())
  resolvedAt  DateTime?
  notes       String?

  handledById String?
  handledBy   User?   @relation("DSRHandledBy", fields: [handledById], references: [id])

  @@map("data_subject_requests")
}

// ---------------------------------------------------------------------------
// Clinical: encounters, vitals, diagnoses, prescriptions, labs
// ---------------------------------------------------------------------------

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  ANTENATAL
}

enum EncounterStatus {
  OPEN
  CLOSED
}

model Encounter {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])

  clinicianId String
  clinician   User   @relation("EncounterClinician", fields: [clinicianId], references: [id])

  type           EncounterType
  status         EncounterStatus @default(OPEN)
  visitDate      DateTime        @default(now())
  chiefComplaint String?
  notes          String?

  clientGeneratedId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vitals        VitalSigns[]
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  chargeLines   ChargeLine[]
  invoices      Invoice[]

  @@index([facilityId, visitDate])
  @@index([patientId, visitDate])
  @@map("encounters")
}

model VitalSigns {
  id          String    @id @default(uuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])

  temperatureC     Float?
  bloodPressureSys Int?
  bloodPressureDia Int?
  pulseBpm         Int?
  respiratoryRate  Int?
  spo2Percent      Int?
  weightKg         Float?
  heightCm         Float?

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])
  recordedAt   DateTime @default(now())

  @@map("vital_signs")
}

model NotifiableDisease {
  id         String  @id @default(uuid())
  icd10Code  String  @unique
  name       String
  /// Reporting timeframe required under NCDC IDSR, e.g. "IMMEDIATE" or "WEEKLY"
  reportingTimeframe String

  diagnoses Diagnosis[]

  @@map("notifiable_diseases")
}

model Diagnosis {
  id          String    @id @default(uuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])

  icd10Code   String
  description String

  notifiableDiseaseId String?
  notifiableDisease    NotifiableDisease? @relation(fields: [notifiableDiseaseId], references: [id])

  notedById String
  notedBy   User   @relation(fields: [notedById], references: [id])
  notedAt   DateTime @default(now())

  notifiableDiseaseReport NotifiableDiseaseReport?

  @@map("diagnoses")
}

model NotifiableDiseaseReport {
  id           String   @id @default(uuid())
  diagnosisId  String   @unique
  diagnosis    Diagnosis @relation(fields: [diagnosisId], references: [id])
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id])

  reportedToNCDC Boolean   @default(false)
  reportedAt     DateTime?

  createdAt DateTime @default(now())

  @@map("notifiable_disease_reports")
}

model Prescription {
  id          String    @id @default(uuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])

  medicationName String
  dosage         String
  frequency      String
  durationDays   Int
  route          String

  prescribedById String
  prescribedBy   User   @relation("PrescriptionPrescriber", fields: [prescribedById], references: [id])

  dispensed     Boolean   @default(false)
  dispensedAt   DateTime?
  dispensedById String?
  dispensedBy   User?     @relation("PrescriptionDispenser", fields: [dispensedById], references: [id])

  createdAt   DateTime @default(now())

  @@map("prescriptions")
}

enum LabOrderStatus {
  ORDERED
  COLLECTED
  RESULTED
  CANCELLED
}

model LabOrder {
  id          String    @id @default(uuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])

  testName String
  status   LabOrderStatus @default(ORDERED)

  orderedById String
  orderedBy   User   @relation(fields: [orderedById], references: [id])
  orderedAt   DateTime @default(now())

  result LabResult?

  @@map("lab_orders")
}

model LabResult {
  id         String   @id @default(uuid())
  labOrderId String   @unique
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id])

  resultValue    String
  unit           String?
  referenceRange String?
  flagged        Boolean @default(false)

  resultedById String
  resultedBy   User   @relation(fields: [resultedById], references: [id])
  resultedAt   DateTime @default(now())

  @@map("lab_results")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id])
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  Role?

  action     String // e.g. "PATIENT_READ", "PATIENT_CREATE", "ENCOUNTER_UPDATE"
  entityType String
  entityId   String?
  patientId  String?

  ipAddress String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Billing / NHIS & HMO claims
//
// Money fields use Float rather than Prisma's Decimal type: Decimal avoids
// floating-point rounding error but doesn't serialize to JSON cleanly
// through Nest/Prisma without extra transform plumbing. Acceptable for this
// reference implementation; a production deployment handling real money
// should switch to Decimal (or integer kobo) and add that transform.
//
// There is no standardised electronic claims-submission API across
// Nigerian HMOs/NHIA, so "submitting" a claim here means exporting it
// (see Claim export) for a human to submit through that payer's own
// portal/process — not a live API call to any payer.
// ---------------------------------------------------------------------------

enum PayerType {
  SELF_PAY
  NHIS
  STATE_SCHEME
  PRIVATE_HMO
}

model Payer {
  id          String    @id @default(uuid())
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id])
  name        String
  type        PayerType
  contactInfo String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  coverages   PatientCoverage[]
  tariffItems TariffItem[]
  invoices    Invoice[]
  claims      Claim[]

  @@unique([facilityId, name])
  @@map("payers")
}

model PatientCoverage {
  id         String    @id @default(uuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id])
  payerId    String
  payer      Payer     @relation(fields: [payerId], references: [id])
  enrolleeId String?
  planName   String?
  validFrom  DateTime?
  validTo    DateTime?
  isPrimary  Boolean   @default(true)
  createdAt  DateTime  @default(now())

  invoices   Invoice[]

  @@index([patientId])
  @@map("patient_coverages")
}

enum TariffCategory {
  CONSULTATION
  LAB
  PROCEDURE
  MEDICATION
  ADMISSION
  OTHER
}

/// Facility-maintained price list. A null payerId is the default/self-pay
/// price; a row with payerId set is a negotiated rate for that specific
/// payer, looked up in preference to the default when billing that payer.
model TariffItem {
  id         String         @id @default(uuid())
  facilityId String
  facility   Facility       @relation(fields: [facilityId], references: [id])
  payerId    String?
  payer      Payer?         @relation(fields: [payerId], references: [id])
  code       String?
  name       String
  category   TariffCategory
  unitPrice  Float
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  chargeLines ChargeLine[]

  @@map("tariff_items")
}

/// An itemized charge against an encounter. description/unitPrice are
/// snapshotted at creation time (from the tariff item, or entered free-text)
/// so a later tariff price change never rewrites an already-billed charge.
model ChargeLine {
  id           String      @id @default(uuid())
  encounterId  String
  encounter    Encounter   @relation(fields: [encounterId], references: [id])
  tariffItemId String?
  tariffItem   TariffItem? @relation(fields: [tariffItemId], references: [id])
  description  String
  quantity     Int         @default(1)
  unitPrice    Float

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("charge_lines")
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id])

  payerId String
  payer   Payer  @relation(fields: [payerId], references: [id])

  coverageId String?
  coverage   PatientCoverage? @relation(fields: [coverageId], references: [id])

  status        InvoiceStatus @default(DRAFT)
  /// Sequential per-facility reference, assigned on finalize (e.g. INV-00001)
  invoiceNumber String?
  subtotal      Float         @default(0)
  amountPaid    Float         @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  finalizedAt DateTime?

  chargeLines ChargeLine[]
  payments    Payment[]

  claimId String?
  claim   Claim?  @relation(fields: [claimId], references: [id])

  @@unique([facilityId, invoiceNumber])
  @@index([facilityId, status])
  @@map("invoices")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CAPITATION
  OTHER
}

model Payment {
  id         String        @id @default(uuid())
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id])
  amount     Float
  method     PaymentMethod
  reference  String?

  receivedById String
  receivedBy   User     @relation(fields: [receivedById], references: [id])
  receivedAt   DateTime @default(now())

  @@map("payments")
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
}

/// A bundle of finalized invoices for one payer over a period, submitted as
/// a single claim — the unit a facility actually sends to an HMO/NHIS.
model Claim {
  id          String   @id @default(uuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id])
  payerId     String
  payer       Payer    @relation(fields: [payerId], references: [id])

  /// Sequential per-facility reference (e.g. CLM-00001)
  claimNumber String
  periodStart DateTime
  periodEnd   DateTime

  status          ClaimStatus @default(DRAFT)
  submittedAt     DateTime?
  adjudicatedAt   DateTime?
  approvedAmount  Float?
  rejectionReason String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  invoices Invoice[]

  @@unique([facilityId, claimNumber])
  @@map("claims")
}
